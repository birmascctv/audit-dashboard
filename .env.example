# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BIRMAS_BACKEND_URL: Target server URL or full direct endpoint URL.
# Examples:
# - Full direct endpoint (no endpoint added): "https://core-api.esb.co.id/extv1/visit-purpose"
# - ESB Core API base: "https://core-api.esb.co.id"
# - WireGuard private tunnel: "http://10.0.0.10"
# - Public WordPress domain: "https://admin.birmas.id"
BIRMAS_BACKEND_URL="https://core-api.esb.co.id/extv1/visit-purpose"

# BIRMAS_API_TOKEN: Secret Bearer token for authenticating with backend (optional)
BIRMAS_API_TOKEN=""

# BIRMAS_ENDPOINT_PATH: API route to append to BIRMAS_BACKEND_URL.
# Set to "" (empty) or "none" to NOT add any endpoint (Direct URL mode).
# Defaults to /wp-json/api/v1/product_stocks only if connecting to a root WordPress host.
# When BIRMAS_BACKEND_URL is already a complete endpoint (e.g. /extv1/visit-purpose), no endpoint is appended.
BIRMAS_ENDPOINT_PATH=""

# BIRMAS_SYNC_INTERVAL_MINUTES: How often to pull stock data quietly in the background (default: 15)
BIRMAS_SYNC_INTERVAL_MINUTES="15"

